{
  "name": "waitlist-kit",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "dev:worker": "wrangler dev",
    "dry:staging": "bunx --bun astro build && wrangler deploy --env staging --dry-run",
    "dry:production": "bunx --bun astro build && wrangler deploy --env production --dry-run",
    "deploy:staging": "bunx --bun astro build && wrangler deploy --env staging",
    "deploy:production": "bunx --bun astro build && wrangler deploy --env production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eslint": "eslint \"src/**/*.{js,astro}\"",
    "dev:all": "concurrently \"bunx --bun astro dev\" \"bun run dev:worker\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply local-d1 --local",
    "db:migrate:staging": "wrangler d1 migrations apply staging-d1 --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply staging-d1 --remote",
    "db:migrations": "wrangler d1 migrations list staging-d1 --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@typescript-eslint/parser": "^8.68.0",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.22",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "^4.23.13"
  }
}
